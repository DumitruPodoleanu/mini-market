@baseUrl = http://localhost:8080
@missingSlug = no-such-product

### Get a product that does not exist
# 404: errors = ["Product with slug 'no-such-product' was not found."]
GET {{baseUrl}}/api/products/{{missingSlug}}

### List with a page below 1
# 400: errors = ["Page must be at least 1."]
GET {{baseUrl}}/api/products?page=0

### List with a page size above the maximum
# 400: errors = ["Page size must be between 1 and 100."]
GET {{baseUrl}}/api/products?pageSize=101

### List with a minimum price above the maximum
# 400: errors = ["Minimum price cannot be greater than maximum price."]
GET {{baseUrl}}/api/products?minPrice=500&maxPrice=100

### List with an unknown sort
# 400: errors = ["Sort must be one of: nameAsc, priceAsc, priceDesc."]
GET {{baseUrl}}/api/products?sort=cheapest

### List with LIKE wildcards in the name
# 200 with no items: % and _ are escaped and searched as plain characters
GET {{baseUrl}}/api/products?name=%25

### Upsert without a vendor
# 400: errors = ["Vendor slug is required."]
PATCH {{baseUrl}}/api/products?sku=MTJV3
Content-Type: application/json

{
  "price": 100
}

### Upsert without a SKU
# 400: errors = ["SKU is required."]
PATCH {{baseUrl}}/api/products?vendorSlug=istore
Content-Type: application/json

{
  "price": 100
}

### Upsert with several invalid fields at once
# 400: errors = ["SKU is required.", "Price must be greater than zero.", "Stock quantity cannot be negative."]
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=
Content-Type: application/json

{
  "price": -5,
  "stockQuantity": -2
}

### Upsert with a SKU in the wrong format
# 400: errors = ["SKU can only contain letters, digits and dashes."]
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=HERB%20001!
Content-Type: application/json

{
  "price": 100
}

### Upsert with a SKU longer than 50 characters (51 here)
# 400: errors = ["SKU cannot exceed 50 characters."]
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
Content-Type: application/json

{
  "price": 100
}

### Upsert with an empty name
# 400: errors = ["Name cannot be empty."]
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=MTJV3
Content-Type: application/json

{
  "name": ""
}

### Upsert with a name longer than 100 characters (101 here)
# 400: errors = ["Name cannot exceed 100 characters."]
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=MTJV3
Content-Type: application/json

{
  "name": "NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN"
}

### Upsert with an empty brand slug
# 400: errors = ["Brand slug cannot be empty."]
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=MTJV3
Content-Type: application/json

{
  "brandSlug": ""
}

### Upsert with an empty category list
# 400: errors = ["At least one category is required."]
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=MTJV3
Content-Type: application/json

{
  "categorySlugs": []
}

### Upsert with an empty category slug
# 400: errors = ["Category slugs cannot be empty."]
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=MTJV3
Content-Type: application/json

{
  "categorySlugs": ["casti", ""]
}

### Upsert a new product without the required fields
# 400: errors = ["Missing fields for a new product: Name, BrandSlug, CategorySlugs."]
# Passes validation; the handler finds no product for istore + NEW-002, so it needs the create fields
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=NEW-002
Content-Type: application/json

{
  "price": 100
}

### Upsert with a vendor that does not exist
# 404: errors = ["Vendor with slug 'nope' does not exist."]
# 404 because the vendor is part of the address, not the body
PATCH {{baseUrl}}/api/products?vendorSlug=nope&sku=MTJV3
Content-Type: application/json

{
  "price": 100
}

### Upsert with a brand that does not exist
# 400: errors = ["Brand with slug 'aple' does not exist."]
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=MTJV3
Content-Type: application/json

{
  "brandSlug": "aple"
}

### Upsert with a category that does not exist
# 400: errors = ["Categories do not exist: nope."]
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=MTJV3
Content-Type: application/json

{
  "categorySlugs": ["casti", "nope"]
}

### Upsert with a slug taken by another product
# 409: errors = ["Slug 'airpods-pro-2-2' is already used by a product."]
# airpods-pro-2-2 belongs to the Smart Store AirPods; nothing is saved
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=MTJV3
Content-Type: application/json

{
  "slug": "airpods-pro-2-2",
  "price": 1
}

### Upsert with a slug taken by a vendor
# 409: errors = ["Slug 'samsung' is already used by a vendor."]
PATCH {{baseUrl}}/api/products?vendorSlug=samsung&sku=SM-S938B
Content-Type: application/json

{
  "slug": "samsung"
}

### Upsert with a slug unrelated to the name
# 400: errors = ["Slug 'banana' must share at least one word with the name."]
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=MTJV3
Content-Type: application/json

{
  "slug": "banana"
}

### Upsert with a slug that has no letters or digits
# 400: errors = ["Slug '!!!' contains no letters or digits."]
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=MTJV3
Content-Type: application/json

{
  "slug": "!!!"
}

### Upsert without a body
# 400: errors = ["Request body is required."]
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=MTJV3

### Upsert with JSON that cannot be read (text where a number is expected)
# 400, not an envelope: the JSON fails to convert before validation runs
PATCH {{baseUrl}}/api/products?vendorSlug=istore&sku=MTJV3
Content-Type: application/json

{
  "price": "abc"
}

### Delete a product that does not exist
# 404: errors = ["Product with slug 'no-such-product' was not found."]
DELETE {{baseUrl}}/api/products/{{missingSlug}}
